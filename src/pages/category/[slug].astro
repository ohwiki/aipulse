---
import CategoryTabs from "@/components/CategoryTabs.astro";
import EmptyState from "@/components/EmptyState.astro";
import HeaderBar from "@/components/HeaderBar.astro";
import NewsCard from "@/components/NewsCard.astro";
import PageIntro from "@/components/PageIntro.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CATEGORY_ORDER, getCategoryMeta } from "@/lib/categories";
import { getDailyDates, getLatestDigest, listCategoryItems } from "@/lib/content";

export const prerender = true;

export function getStaticPaths() {
  return CATEGORY_ORDER.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const category = slug ?? "";
const meta = getCategoryMeta(category);
const [latest, items, dailyDates] = await Promise.all([getLatestDigest(), listCategoryItems(category), getDailyDates()]);
const dayLabel = latest.days > 0 ? `最近 ${latest.days} 天` : "最近一段时间";
const latestDailyDate = dailyDates[0];
const latestDayItems = latestDailyDate
  ? items.filter((item) => (item.publishedAt ? item.publishedAt.startsWith(latestDailyDate) : false))
  : [];
const hasLatestDayItems = latestDayItems.length > 0;

function slugify(value: string) {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "") || "source";
}

const sourceGroups = Array.from(
  items.reduce((map, item) => {
    const key = item.source || "未知来源";
    const bucket = map.get(key) ?? [];
    bucket.push(item);
    map.set(key, bucket);
    return map;
  }, new Map<string, typeof items>())
).map(([source, sourceItems]) => ({
  source,
  sourceItems,
  anchor: `source-${slugify(source)}`
}));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${meta.label} 条目流`,
  numberOfItems: items.length,
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: item.url,
    name: item.title
  }))
};
---

<BaseLayout
  title={`AIpulse | ${meta.label}`}
  description={`查看${dayLabel}的 ${meta.label} 条目，快速掌握该主题下值得关注的 AI 动态。`}
  schemaType="CollectionPage"
  structuredData={structuredData}
>
  <HeaderBar currentPath={Astro.url.pathname} />

  <main id="top" class="container page-main">
    <PageIntro
      eyebrow="分类浏览"
      title={meta.label}
      description={`${meta.description} ${dayLabel}内的相关条目会按更适合扫读的顺序连续展示。`}
      pills={[dayLabel, `${items.length} 条`]}
    />

    <section class="page-section category-context surface-panel">
      <div class="category-context-copy">
        <p class="eyebrow">专题流</p>
        <h2 class="section-title">围绕同一主题连续浏览</h2>
        <p class="section-copy">当前页重点是正文流本身。切换分类时保持轻导航，减少对阅读路径的打断。</p>
      </div>
      <CategoryTabs activeCategory={category} variant="compact" />
    </section>

    {
      latestDailyDate && !hasLatestDayItems && items.length > 0 && (
        <section class="page-section freshness-note surface-panel">
          <p class="eyebrow">当日更新状态</p>
          <h2 class="section-title">{latestDailyDate} 暂无这个分类的新条目</h2>
          <p class="section-copy">
            当前页展示的是最近 {latest.days} 天内的累计内容。也就是说，这不是漏渲染，而是最新一期日报里这个分类当天没有入选内容。
          </p>
        </section>
      )
    }

    {
      sourceGroups.length > 1 && (
        <section class="page-section source-jump surface-panel">
          <div class="source-jump-copy">
            <p class="eyebrow">来源跳转</p>
            <p class="section-copy">按来源快速定位，适合先看官方发布，再扫产品榜和论文源。</p>
          </div>
          <nav class="source-jump-links" aria-label="来源跳转">
            {sourceGroups.map((group) => <a href={`#${group.anchor}`}>{group.source} <span>{group.sourceItems.length}</span></a>)}
          </nav>
        </section>
      )
    }

    {
      items.length > 0 ? (
        sourceGroups.map((group) => (
          <section class="page-section source-group" id={group.anchor}>
            <div class="source-group-head">
              <div class="section-kicker">
                <p class="eyebrow">{group.source}</p>
                <span class="count-chip">{group.sourceItems.length} 条</span>
              </div>
              <a class="source-back-link" href="#top">回到页首</a>
            </div>
            <div class="content-list">
              {group.sourceItems.map((item) => <NewsCard item={item} variant="full" />)}
            </div>
          </section>
        ))
      ) : (
        <EmptyState title="这个分类暂时没有内容" description="请切换其他分类或返回首页。" actionHref="/archive" actionLabel="去看归档" />
      )
    }
  </main>

  <SiteFooter generatedAt={latest.generatedAt} />
</BaseLayout>

<style>
  .category-context {
    display: grid;
    gap: 12px;
  }

  .category-context-copy {
    display: grid;
    gap: 6px;
  }

  .category-context-copy .eyebrow,
  .category-context-copy .section-title,
  .category-context-copy .section-copy {
    margin: 0;
  }

  .source-jump,
  .source-group,
  .freshness-note {
    display: grid;
    gap: 12px;
  }

  .source-jump-copy .eyebrow,
  .source-jump-copy .section-copy,
  .freshness-note .eyebrow,
  .freshness-note .section-title,
  .freshness-note .section-copy {
    margin: 0;
  }

  .source-jump-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .source-jump-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 12px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--font-sm);
    font-weight: 600;
  }

  .source-jump-links span,
  .count-chip {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 8px;
    color: var(--text-muted);
    font-size: var(--font-xs);
    font-weight: 700;
    background: color-mix(in srgb, var(--surface) 88%, var(--surface-muted));
  }

  .source-group-head,
  .section-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .section-kicker .eyebrow {
    margin: 0;
  }

  .source-group-head {
    justify-content: space-between;
  }

  .source-back-link {
    color: var(--accent-text);
    font-size: var(--font-sm);
    font-weight: 600;
  }

  @media (min-width: 960px) {
    .category-context {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 20px;
    }
  }
</style>
